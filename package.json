{
  "name": "windows-quick-settings",
  "version": "0.1.1",
  "description": "Wi-Fi, Bluetooth, audio, brightness, night mode, HDR and a frame limit in Steam Big Picture's Quick Access Menu on Windows",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aqvilinus/windows-quick-settings.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "windows",
    "quick-settings"
  ],
  "author": "Aqvilinus",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Aqvilinus/windows-quick-settings/issues"
  },
  "homepage": "https://github.com/Aqvilinus/windows-quick-settings#readme",
  "packageManager": "pnpm@12.14.0",
  "devDependencies": {
    "@decky/api": "1.1.3",
    "@decky/rollup": "1.0.2",
    "@decky/ui": "4.16.3",
    "rollup": "4.65.1"
  }
}
